# Copia in .env.local e compila con i dati del progetto Firebase.
# Se queste variabili mancano, l'app parte in modalità demo (dati solo sul dispositivo).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Firebase console > Impostazioni progetto > Cloud Messaging > Certificati push web
VITE_FIREBASE_VAPID_KEY=
